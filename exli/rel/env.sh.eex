#!/bin/sh

# Runtime environment of the release (sourced by bin/exli). Production runs
# as a single node in Docker under Coolify, not on Fly.io, so nothing here
# depends on FLY_* variables; the release keeps its default node name and
# distribution, and DNSCluster stays off (DNS_CLUSTER_QUERY unset).

# Ecto reaches the database over IPv6 unless the environment says otherwise.
# This is what production has always run with; set ECTO_IPV6=false in the
# deployment's environment to use IPv4.
export ECTO_IPV6="${ECTO_IPV6:-true}"
